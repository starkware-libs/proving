#[test]
fn test_security_bits() {
    let config = FriParams {
        pow_bits: 42,
        log_blowup_factor: 10,
        log_last_layer_degree_bound: 1,
        n_queries: 70,
        fold_step: 1,
    };
    assert_eq!(config.security_bits(), 10 * 70 + 42);
}

#[test]
fn test_validate_accepts_supported_fold_steps() {
    for fold_step in 1..5_u32 {
        let params = FriParams {
            pow_bits: 20,
            log_blowup_factor: 1,
            log_last_layer_degree_bound: 0,
            n_queries: 1,
            fold_step,
        };
        params.validate(min_security_bits: 0);
    }
}

